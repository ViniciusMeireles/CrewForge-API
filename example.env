# PostrgreSQL
POSTGRES_DB=crew_forge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# Django API
ENVIRONMENT=local_development
DJANGO_WSGI_MODULE=config.wsgi
ALLOWED_HOSTS=*
# Required outside local/test: 50+ random characters (python -c "import secrets; print(secrets.token_urlsafe(64))").
# Leave empty for local development (config.settings.local uses a dev-only key).
DJANGO_SECRET_KEY=
# Optional: separate key for signing JWTs (defaults to DJANGO_SECRET_KEY).
# JWT_SIGNING_KEY=
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
PYTHONUNBUFFERED=1
STATIC_ROOT=/staticfiles
MEDIA_ROOT=/media/
MEDIA_URL=/media/
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ─── Cookie / SameSite Configuration ──────────────────────────────────
# Default: SameSite=Lax (SPA and API on the same origin behind the proxy).
# Use SameSite=None (+ Secure=True) only if SPA and API are on different sites.
#
# WARNING: SameSite=None + Secure=False is INVALID and cookies will be
# silently rejected by modern browsers.
# SESSION_COOKIE_SAMESITE=Lax        # Lax (default) | None (cross-site only)
# CSRF_COOKIE_SAMESITE=Lax           # Lax (default) | None (cross-site only)
# SESSION_COOKIE_SECURE=True         # True (prod) | False (dev)
# CSRF_COOKIE_SECURE=True            # True (prod) | False (dev)

# Shared session cookie domain for subdomains (e.g. .example.com)
# SESSION_COOKIE_DOMAIN=.example.com

# Trusted origins for CSRF. Browsers use HttpOnly auth cookies + CSRF, so behind a
# TLS-terminating proxy either set SECURE_PROXY_SSL_HEADER=True (and forward the
# original X-Forwarded-Proto) or list the public origin here.
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_PROXY_SSL_HEADER=True

# Number of trusted reverse proxies in front of the API (client IP for throttling and
# security logs). 1 behind the Frontend nginx; add one per extra load balancer.
# Unset trusts X-Forwarded-For as sent by the client (only safe without proxies).
# NUM_PROXIES=1

# ─── Hardening ─────────────────────────────────────────────────────────
# API schema/Swagger/Redoc are public only when DEBUG=True; otherwise staff only.
# API_DOCS_PUBLIC=False
# Django admin path (keep it off the public proxy; the Frontend nginx only forwards /api/)
# ADMIN_URL=admin/
# HSTS (production): one year by default; enable preload only after submitting the domain
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# Level of the "security" logger (auth events)
# SECURITY_LOG_LEVEL=INFO

## System
SYSTEM_TITLE=CrewForge

## Email configuration
DEFAULT_FROM_EMAIL=crew_forge <noreply@crew_forge.com>
SERVER_EMAIL=CrewForge <noreply@crew_forge.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=crew_forge@crew_forge.com
FROM_MAIL=CrewForge <noreply@crew_forge.com>
EMAIL_HOST_PASSWORD=password
## Simple JWT
# JWT lifetimes in minutes (access 15 min, refresh 7 days)
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=10080
# Rate limits for login/signup/password reset and for token refresh
# AUTH_THROTTLE_RATE=10/min
# AUTH_REFRESH_THROTTLE_RATE=60/min

START_API=False

# Frontend
FRONTEND_URL=http://localhost:4200
FRONTEND_RESET_URL=http://localhost:4200/reset-password
# Email verification link (defaults to FRONTEND_URL + /auth/verify-email)
# FRONTEND_VERIFY_EMAIL_URL=http://localhost:4200/auth/verify-email

# Flower (Celery monitor) refuses to start without basic auth (user:password)
FLOWER_BASIC_AUTH=flower:change-me

# Redis and Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API
SELF_URL=http://localhost:8000
